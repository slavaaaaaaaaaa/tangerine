# ---------------------------------------------------------------- documents

def canonical_doc_path(path):
    """'/A/B/C%20D/section/page/' -> '/A/B/C%20D/' (re-encoded the way the archive server does)"""
    segs = [s for s in (path or "").split("?")[0].split("/") if s]
    if len(segs) < 3 or segs[0].startswith("_") or segs[0] == "bundle":
        return None
    return "/" + "/".join(urllib.parse.quote(urllib.parse.unquote(s), safe="") for s in segs[:3]) + "/"


def doc_name(path):
    return " · ".join(urllib.parse.unquote(s) for s in path.strip("/").split("/"))


class Catalog:
    """uriPaths of every document in the configured index.json files."""

    def __init__(self, index_paths):
        self.paths = set()
        for p in index_paths:
            with open(p, "rb") as f:
                data = f.read()
            for m in re.finditer(rb'"uriPath"\s*:\s*"((?:[^"\\]|\\.)*)"', data):
                d = canonical_doc_path(json.loads(b'"' + m.group(1) + b'"'))
                if d:
                    self.paths.add(d)
            del data
        log("catalog: %d documents" % len(self.paths))

    def __contains__(self, path):
        return path in self.paths


# ---------------------------------------------------------------- page parsing

BLOCK = {"p", "div", "br", "li", "tr", "h1", "h2", "h3", "h4", "h5", "h6", "ol", "ul", "table",
         "dt", "dd", "section", "pre", "blockquote", "hr"}


class PageParser(html.parser.HTMLParser):
    """The .main part of an archive page -> text with [figure N] markers, figures, links."""

    def __init__(self, page_url):
        super().__init__(convert_charrefs=True)
        self.page_url = page_url
        self.out = []
        self.figures = []
        self.links = []
        self.link_chars = 0
        self.in_link = 0
        self.skip = 0

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag in ("script", "style"):
            self.skip += 1
        elif tag in BLOCK:
            self.out.append("\n")
            if tag == "li":
                self.out.append("- ")
        elif tag in ("td", "th"):
            self.out.append(" | ")
        if tag == "a":
            self.in_link += 1
            if a.get("href"):
                self.links.append(a["href"])
        elif tag == "img" and "folder-icon" not in (a.get("class") or "") and a.get("src"):
            self.figures.append(urllib.parse.urljoin(self.page_url, a["src"]))
            self.out.append(" [figure %d] " % len(self.figures))

    def handle_endtag(self, tag):
        if tag in ("script", "style"):
            self.skip = max(0, self.skip - 1)
        elif tag == "a":
            self.in_link = max(0, self.in_link - 1)
        elif tag in BLOCK:
            self.out.append("\n")

    def handle_data(self, data):
        if self.skip:
            return
        self.out.append(data)
        if self.in_link:
            self.link_chars += len(data.strip())

    def text(self):
        t = "".join(self.out)
        t = re.sub(r"[ \t\r\f\v\xa0]+", " ", t)
        t = re.sub(r" *\n[ \n]*", "\n", t)
        return t.strip()


MAIN_RE = re.compile(r'<div class="main">(.*)</div><div class="theme-colors footer"', re.S)
CRUMB_RE = re.compile(r'class="breadcrumb-part"[^>]*>([^<]*)<')
H1_RE = re.compile(r"<h1>(.*?)</h1>", re.S)


def parse_page(page_url, raw):
    m = MAIN_RE.search(raw)
    main = m.group(1) if m else ""
    p = PageParser(page_url)
    p.feed(main)
    p.close()
    body = p.text()
    h1 = H1_RE.search(main)
    title = html.unescape(re.sub(r"<[^>]+>", "", h1.group(1))).strip() if h1 else ""
    crumbs = [html.unescape(c).strip() for c in CRUMB_RE.findall(raw)][4:]   # after Home > make > year > model
    content = body[len(title):].strip() if body.startswith(title) else body
    # Folder pages are lists of links; only leaves with real text get indexed.
    is_folder = len(content) - p.link_chars < 40 or "li-folder" in main
    other = "other-warning" in main or any(x in page_url for x in ("/External%20Pages/", "/Other%20Variant/"))
    return {"title": title or (crumbs[-1] if crumbs else ""), "crumbs": crumbs, "body": body,
            "figures": p.figures, "links": p.links, "is_folder": is_folder, "other": other}


# ---------------------------------------------------------------- index database

INDEX_SCHEMA = """
CREATE TABLE IF NOT EXISTS docs (
    id INTEGER PRIMARY KEY, path TEXT UNIQUE NOT NULL, name TEXT NOT NULL,
    status TEXT NOT NULL,            -- queued | indexing | ready | failed | evicted
    error TEXT, pages INTEGER NOT NULL DEFAULT 0, sections TEXT,
    questions INTEGER NOT NULL DEFAULT 0, last_asked REAL, indexed_at REAL);
CREATE TABLE IF NOT EXISTS pages (
    id INTEGER PRIMARY KEY, hash BLOB UNIQUE NOT NULL, title TEXT NOT NULL,
    other INTEGER NOT NULL, figures TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS doc_pages (
    doc INTEGER NOT NULL, path TEXT NOT NULL, page INTEGER NOT NULL, PRIMARY KEY (doc, path));
CREATE INDEX IF NOT EXISTS doc_pages_page ON doc_pages(page);
-- rowid = pages.id; `docs` holds a "d<id>" token for each document that has the page.
CREATE VIRTUAL TABLE IF NOT EXISTS fts USING fts5(docs, title, crumbs, body, tokenize='porter unicode61');
"""

ASK_SCHEMA = """
CREATE TABLE IF NOT EXISTS users (
    name TEXT PRIMARY KEY, provider TEXT, model TEXT, key_enc TEXT, key_hint TEXT, privacy_ack REAL);
-- Conversations live in each user's browser now; earlier versions kept them here.
DROP TABLE IF EXISTS messages;
DROP TABLE IF EXISTS chats;
"""

_local = threading.local()


def connect(name, schema):
    import sqlite3
    db = sqlite3.connect(os.path.join(STATE_DIR, name), isolation_level=None, timeout=60,
                         check_same_thread=False)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA synchronous=NORMAL")
    db.executescript(schema)
    return db


INDEX_LAYOUT = 2   # bump when INDEX_SCHEMA changes incompatibly


def upgrade_index_layout():
    """The index is only a cache of the archive, so an older layout is simply
    dropped and rebuilt: documents re-index on their next question."""
    db = connect("index.db", "")
    if db.execute("PRAGMA user_version").fetchone()[0] < INDEX_LAYOUT:
        # Full-text tables first: dropping one also drops its shadow tables.
        tables = [r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type = 'table' "
                                           "AND name NOT LIKE 'sqlite_%' ORDER BY sql NOT LIKE 'CREATE VIRTUAL%'")]
        if tables:
            log("index: older layout, starting a fresh index")
        for t in tables:
            db.execute('DROP TABLE IF EXISTS "%s"' % t.replace('"', '""'))
        db.execute("PRAGMA user_version = %d" % INDEX_LAYOUT)
        db.execute("VACUUM")
    db.close()


def idx():
    if not hasattr(_local, "idx"):
        _local.idx = connect("index.db", INDEX_SCHEMA)
    return _local.idx


def adb():
    if not hasattr(_local, "adb"):
        _local.adb = connect("ask.db", ASK_SCHEMA)
    return _local.adb


def index_used_bytes(db):
    """Bytes in use, not file size: pages freed by eviction are reused before the file grows."""
    page_size = db.execute("PRAGMA page_size").fetchone()[0]
    count = db.execute("PRAGMA page_count").fetchone()[0]
    free = db.execute("PRAGMA freelist_count").fetchone()[0]
    return (count - free) * page_size


def remove_doc_pages(db, did):
    """Drop a document's pages from the index; pages other documents also have stay."""
    tok = "d%d" % did
    db.execute("BEGIN")
    for (pid,) in db.execute("SELECT DISTINCT page FROM doc_pages WHERE doc = ?", (did,)).fetchall():
        row = db.execute("SELECT docs FROM fts WHERE rowid = ?", (pid,)).fetchone()
        rest = [t for t in (row[0] if row else "").split() if t != tok]
        if rest:
            db.execute("UPDATE fts SET docs = ? WHERE rowid = ?", (" ".join(rest), pid))
        else:
            db.execute("DELETE FROM fts WHERE rowid = ?", (pid,))
            db.execute("DELETE FROM pages WHERE id = ?", (pid,))
    db.execute("DELETE FROM doc_pages WHERE doc = ?", (did,))
    db.execute("COMMIT")


def make_room(db, keep_did):
    """Evict least-asked documents until the index is under evict_at x index_max_gb."""
    limit = S["index_max_gb"] * 1e9 * S["evict_at"]
    while index_used_bytes(db) > limit:
        victim = db.execute("SELECT id, path, questions FROM docs WHERE status = 'ready' AND id != ? "
                            "ORDER BY questions, COALESCE(last_asked, 0), indexed_at LIMIT 1",
                            (keep_did,)).fetchone()
        if not victim:
            return
        log("index: %.1f GB in use, evicting %s (%d questions)"
            % (index_used_bytes(db) / 1e9, victim["path"], victim["questions"]))
        remove_doc_pages(db, victim["id"])
        db.execute("UPDATE docs SET status = 'evicted', pages = 0, sections = NULL WHERE id = ?",
                   (victim["id"],))


# ---------------------------------------------------------------- crawling

class Fetcher:
    """GETs from tangerine-crawl, a copy of the archive server that only we use.
    The public one rate-limits per client; this one has no limits, so a whole
    document takes about a minute instead of twenty."""

    def get(self, url):
        for attempt in range(4):
            req = urllib.request.Request(url, headers={"User-Agent": "tangerine-ask"})
            try:
                with urllib.request.urlopen(req, timeout=60) as r:
                    return r.read().decode("utf-8", "replace")
            except urllib.error.HTTPError as e:
                if e.code == 404:
                    return None
                if attempt == 3:
                    raise
            except (urllib.error.URLError, TimeoutError):
                if attempt == 3:
                    raise
            time.sleep(1 + attempt)


def crawl_and_index(did, dpath, progress):
    """Walk every page under the document and index the leaves."""
    db = idx()
    app = S["crawl_url"].rstrip("/")
    fetcher = Fetcher()
    tok = "d%d" % did
    seen, indexed = {""}, 0
    pending = []

    errors = [0]

    def fetch(rel):
        try:
            raw = fetcher.get(app + dpath + rel)
            # Parse against the path only: figure URLs must stay relative to the public site,
            # not point at the crawler's localhost server.
            return rel, (parse_page(dpath + rel, raw) if raw else None)
        except Exception as e:
            errors[0] += 1
            log("index: %s%s: %r" % (dpath, rel, e))
            return rel, None

    def flush():
        nonlocal indexed
        db.execute("BEGIN")
        for rel, pg in pending:
            figures = json.dumps(pg["figures"])
            h = hashlib.sha256((pg["title"] + "\0" + pg["body"] + "\0" + figures).encode()).digest()
            row = db.execute("SELECT id FROM pages WHERE hash = ?", (h,)).fetchone()
            if row:
                pid = row[0]
                cur = db.execute("SELECT docs FROM fts WHERE rowid = ?", (pid,)).fetchone()
                toks = (cur[0] if cur else "").split()
                if tok not in toks:
                    db.execute("UPDATE fts SET docs = ? WHERE rowid = ?", (" ".join(toks + [tok]), pid))
            else:
                pid = db.execute("INSERT INTO pages (hash, title, other, figures) VALUES (?,?,?,?)",
                                 (h, pg["title"], int(pg["other"]), figures)).lastrowid
                db.execute("INSERT INTO fts (rowid, docs, title, crumbs, body) VALUES (?,?,?,?,?)",
                           (pid, tok, pg["title"], " > ".join(pg["crumbs"]), pg["body"]))
            db.execute("INSERT OR IGNORE INTO doc_pages (doc, path, page) VALUES (?,?,?)", (did, rel, pid))
            indexed += 1
        db.execute("COMMIT")
        pending.clear()
        make_room(db, did)

    # Each section has a "(Single Page)" twin listing every page under it, which
    # saves fetching all the folder pages of the split tree.
    root = fetch("")[1]
    if not root:
        raise RuntimeError("the archive server has no page for this document")
    fetched = 1
    sections = [l for l in root["links"] if not l.startswith(("/", "#", "..")) and "%28Single%20Page%29" not in l]
    frontier = []
    for sec in sections:
        twin = sec.rstrip("/") + "%20%28Single%20Page%29/"
        raw = fetcher.get(app + dpath + twin) if twin in root["links"] else None
        fetched += 1
        hrefs = re.findall(r'<a href="([^"#]+)"', MAIN_RE.search(raw).group(1)) if raw and MAIN_RE.search(raw) else []
        hrefs = [h for h in hrefs if not h.startswith(("/", ".."))]
        for child in ([sec + h for h in hrefs] if hrefs else [sec]):
            if child not in seen:
                seen.add(child)
                frontier.append(child)

    with ThreadPoolExecutor(CRAWL_THREADS) as pool:
        while frontier and fetched < MAX_PAGES:
            batch, frontier = frontier[:500], frontier[500:]
            for rel, pg in pool.map(fetch, batch):
                fetched += 1
                if not pg:
                    continue
                if not pg["is_folder"]:
                    pending.append((rel, pg))
                for href in pg["links"]:
                    url = urllib.parse.urljoin(dpath + rel, href).split("#")[0].split("?")[0]
                    if not url.startswith(dpath):
                        continue
                    child = url[len(dpath):]
                    if child not in seen and "%28Single%20Page%29" not in child.split("/")[0]:
                        seen.add(child)
                        frontier.append(child)
            flush()
            progress(fetched, len(seen), indexed)
            if errors[0] > 50 and errors[0] > fetched * 0.02:
                raise RuntimeError("too many pages failed to load from the archive server")
    # Pages shared with already-indexed documents were rewritten to add this one.
    # Force a few bounded merges so the index drops the old copies (a near-duplicate document
    # then costs ~10 MB instead of ~20).
    for _ in range(3):
        before = db.total_changes
        db.execute("INSERT INTO fts (fts, rank) VALUES ('merge', -2000)")
        if db.total_changes - before < 2:
            break
    names = [urllib.parse.unquote(s.strip("/")) for s in sections]
    return indexed, names


class Indexer:
    def __init__(self):
        self.q = queue.Queue()
        self.progress = {}      # document id -> (fetched, discovered, indexed)
        db = idx()
        # Early versions stored figure URLs with the crawler's http://127.0.0.1:port in front,
        # which browsers can't (and shouldn't) load. Keep just the path.
        n = 0
        db.execute("BEGIN")
        for pid, figures in db.execute("SELECT id, figures FROM pages WHERE figures LIKE '%://%'").fetchall():
            fixed = json.dumps([re.sub(r"^https?://[^/]+", "", f) for f in json.loads(figures)])
            n += db.execute("UPDATE pages SET figures = ? WHERE id = ?", (fixed, pid)).rowcount
        db.execute("COMMIT")
        if n:
            log("index: made figure links relative on %d pages" % n)
        # A restart mid-crawl leaves partial data behind; redo those.
        for r in db.execute("SELECT id, path FROM docs WHERE status IN ('queued', 'indexing')").fetchall():
            remove_doc_pages(db, r["id"])
            db.execute("UPDATE docs SET status = 'queued' WHERE id = ?", (r["id"],))
            self.q.put((r["id"], r["path"]))
        threading.Thread(target=self._loop, daemon=True).start()

    def request(self, dpath):
        db = idx()
        db.execute("INSERT OR IGNORE INTO docs (path, name, status) VALUES (?,?,'evicted')",
                   (dpath, doc_name(dpath)))
        r = db.execute("UPDATE docs SET status = 'queued', error = NULL WHERE path = ? "
                       "AND status IN ('failed', 'evicted') RETURNING id", (dpath,)).fetchone()
        if r:
            self.q.put((r[0], dpath))

    def _loop(self):
        while True:
            did, dpath = self.q.get()
            db = idx()
            db.execute("UPDATE docs SET status = 'indexing' WHERE id = ?", (did,))
            t = time.time()
            log("index: crawling %s" % dpath)
            try:
                n, sections = crawl_and_index(did, dpath, lambda *p: self.progress.__setitem__(did, p))
                if not n:
                    raise RuntimeError("no pages found")
                db.execute("UPDATE docs SET status = 'ready', pages = ?, sections = ?, indexed_at = ? "
                           "WHERE id = ?", (n, json.dumps(sections), time.time(), did))
                log("index: %s ready, %d pages in %ds, index %.2f GB"
                    % (dpath, n, time.time() - t, index_used_bytes(db) / 1e9))
            except Exception as e:
                log("index: %s failed: %r" % (dpath, e))
                try:
                    if db.in_transaction:
                        db.execute("ROLLBACK")
                    remove_doc_pages(db, did)
                finally:
                    db.execute("UPDATE docs SET status = 'failed', error = ? WHERE id = ?",
                               (str(e)[:300], did))
            self.progress.pop(did, None)


# ---------------------------------------------------------------- tools the model can call

def fts_query(text):
    terms = []
    for t in re.findall(r"\w[\w.\-/]*", text.lower()):
        t = t.strip(".-/")
        if t and t not in terms:
            terms.append(t)
    return " OR ".join('"%s"' % t for t in terms[:24])


class Doc:
    """One document's view of the index."""

    def __init__(self, doc):
        self.d = doc
        self.did = doc["id"]
        self.db = idx()
        self.seen = {}   # page id -> metadata, for citations

    def _remember(self, pid):
        if pid not in self.seen:
            r = self.db.execute("SELECT p.title, p.figures, p.other, dp.path FROM pages p JOIN doc_pages dp "
                                "ON dp.page = p.id AND dp.doc = ? WHERE p.id = ? LIMIT 1",
                                (self.did, pid)).fetchone()
            if not r:
                return None
            crumbs = self.db.execute("SELECT crumbs FROM fts WHERE rowid = ?", (pid,)).fetchone()[0]
            self.seen[pid] = {"id": pid, "title": r["title"], "crumbs": crumbs, "other": bool(r["other"]),
                              "url": self.d["path"] + r["path"], "figures": json.loads(r["figures"])}
        return self.seen[pid]

    def search(self, query, include_other_variants=False):
        q = fts_query(query)
        if not q:
            return "Empty query."
        rows = self.db.execute(
            "SELECT f.rowid AS id, f.title, f.crumbs, p.other, "
            "snippet(fts, 3, '«', '»', ' … ', 28) AS snip, bm25(fts, 0.0, 8.0, 3.0, 1.0) AS rank "
            "FROM fts f JOIN pages p ON p.id = f.rowid WHERE fts MATCH ? ORDER BY rank LIMIT 40",
            ('docs:"d%d" AND (%s)' % (self.did, q),)).fetchall()
        own = [r for r in rows if not r["other"]]
        others = [r for r in rows if r["other"]]
        picked = (own[:8] + others[:4]) if include_other_variants else (own[:8] or others[:4])
        if not picked:
            return "No pages matched %r. Try other words, or list_sections to browse." % query
        out = []
        for r in picked:
            self._remember(r["id"])
            out.append("[p:%d] %s%s\n  in: %s\n  %s" % (r["id"], r["title"], "  (OTHER VARIANT)" if r["other"] else "",
                                                       r["crumbs"], r["snip"].replace("\n", " ")))
        return "\n".join(out)

    def read_page(self, page_id):
        try:
            pid = int(str(page_id).strip("[]p: "))
        except ValueError:
            return "Give a numeric page id from search results."
        meta = self._remember(pid)
        if not meta:
            return "No page %s in this document." % page_id
        body = self.db.execute("SELECT body FROM fts WHERE rowid = ?", (pid,)).fetchone()[0]
        if len(body) > READ_PAGE_CHARS:
            body = body[:READ_PAGE_CHARS] + "\n[... page truncated ...]"
        note = ("NOTE: this page was written for a DIFFERENT variant than the user's.\n" if meta["other"] else "")
        return "[p:%d] %s\nin: %s\n%s\n%s" % (pid, meta["title"], meta["crumbs"], note, body)

    def list_sections(self, path=None):
        want = [str(s) for s in (path or []) if s]
        children = {}
        for r in self.db.execute("SELECT path, page FROM doc_pages WHERE doc = ?", (self.did,)):
            segs = [urllib.parse.unquote(x) for x in r["path"].strip("/").split("/")]
            if len(segs) <= len(want) or segs[:len(want)] != want:
                continue
            c = children.setdefault(segs[len(want)], {"pages": 0, "page": None})
            c["pages"] += 1
            if len(segs) == len(want) + 1:
                c["page"] = r["page"]
        if not children:
            return "Nothing under %s." % (" > ".join(path or []) or "the top level")
        lines = []
        for name in sorted(children)[:300]:
            c = children[name]
            if c["page"] and c["pages"] == 1:
                self._remember(c["page"])
                lines.append("- [p:%d] %s" % (c["page"], name))
            else:
                lines.append("- %s/  (%d pages)" % (name, c["pages"]))
        return "\n".join(lines)


