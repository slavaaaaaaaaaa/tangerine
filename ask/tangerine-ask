# A listed model may come back with a snapshot date or "-latest"; anything else after
# the name (e.g. "-deep-research") is a different model with its own price.
SNAPSHOT_RE = re.compile(r"(-\d{4}-\d{2}-\d{2}|-\d{8}|-latest)?$")


def price(model):
    """{"input", "cached", "output"} in USD per million tokens, or None if unknown."""
    table = dict(PRICES)
    for name, p in (S.get("prices") or {}).items():
        table[str(name)] = ((p.get("input"), p.get("cached"), p.get("output"), p.get("note"))
                            if isinstance(p, dict) else None)
    best = None
    for name, p in table.items():
        if p and model.startswith(name) and SNAPSHOT_RE.fullmatch(model[len(name):]):
            if best is None or len(name) > len(best[0]):
                best = (name, p)
    if not best:
        return None
    return dict(zip(("input", "cached", "output", "note"), tuple(best[1]) + (None,) * (4 - len(best[1]))))


def priced(ids):
    return [{"id": m, "price": price(m)} for m in ids]


def list_models(provider, key):
    if provider == "anthropic":
        import anthropic
        c = anthropic.Anthropic(api_key=key, max_retries=1, timeout=20)
        return [m.id for m in c.models.list(limit=100)]
    import openai
    c = openai.OpenAI(api_key=key, max_retries=1, timeout=20)
    skip = ("audio", "realtime", "transcribe", "tts", "image", "search", "instruct", "embedding",
            "moderation", "dall-e", "whisper", "codex", "computer")
    ids = [m.id for m in c.models.list()
           if re.match(r"(gpt-|o\d|chatgpt-)", m.id) and not any(s in m.id for s in skip)]
    return sorted(ids, reverse=True)


def provider_error(e):
    """Short, user-facing text for SDK errors (never echo the key)."""
    status = getattr(e, "status_code", None)
    if status == 401:
        return "The provider rejected your API key. Check it in settings."
    if status == 403:
        return "Your API key isn't allowed to use this model."
    if status == 404:
        return "The provider doesn't know that model. Pick another in settings."
    if status == 429:
        return "The provider says you're over your rate limit or out of credit. Try again shortly."
    msg = getattr(e, "message", None) or str(e)
    return "Provider error%s: %s" % (" %s" % status if status else "", msg[:300])


def chat_anthropic(key, model, system, history, doc, emit):
    import anthropic
    c = anthropic.Anthropic(api_key=key, max_retries=2, timeout=300)
    tools = [{"name": t["name"], "description": t["description"], "input_schema": t["schema"]} for t in TOOLS]
    msgs = [{"role": m["role"], "content": m["content"]} for m in history]
    text = []
    for rnd in range(MAX_TOOL_ROUNDS + 1):
        extra = {"tool_choice": {"type": "none"}} if rnd == MAX_TOOL_ROUNDS else {}
        if text and not text[-1].endswith("\n"):
            text.append("\n\n")
            emit("text", "\n\n")
        with c.messages.stream(model=model, max_tokens=8192, system=system, messages=msgs, tools=tools,
                               cache_control={"type": "ephemeral"}, **extra) as s:
            for ev in s:
                if ev.type == "text":
                    text.append(ev.text)
                    emit("text", ev.text)
            msg = s.get_final_message()
        uses = [b for b in msg.content if b.type == "tool_use"]
        if msg.stop_reason != "tool_use" or not uses:
            break
        msgs.append({"role": "assistant", "content": msg.content})
        results = []
        for b in uses:
            emit("status", tool_status(b.name, b.input))
            results.append({"type": "tool_result", "tool_use_id": b.id, "content": run_tool(doc, b.name, b.input)})
        msgs.append({"role": "user", "content": results})
    return "".join(text)


def chat_openai(key, model, system, history, doc, emit):
    import openai
    c = openai.OpenAI(api_key=key, max_retries=2, timeout=300)
    tools = [{"type": "function", "name": t["name"], "description": t["description"],
              "parameters": t["schema"], "strict": False} for t in TOOLS]
    items = [{"role": m["role"], "content": m["content"]} for m in history]
    text = []
    include = ["reasoning.encrypted_content"]   # store=False, so reasoning has to travel with the request
    for rnd in range(MAX_TOOL_ROUNDS + 1):
        extra = {"tool_choice": "none"} if rnd == MAX_TOOL_ROUNDS else {}
        if text and not text[-1].endswith("\n"):
            text.append("\n\n")
            emit("text", "\n\n")
        try:
            with c.responses.stream(model=model, instructions=system, input=items, tools=tools, store=False,
                                    include=include, **extra) as s:
                for ev in s:
                    if ev.type == "response.output_text.delta":
                        text.append(ev.delta)
                        emit("text", ev.delta)
                r = s.get_final_response()
        except openai.BadRequestError as e:
            if include and not text and any(w in str(e).lower() for w in ("encrypted", "include")):
                include = []          # non-reasoning model
                continue
            raise
        calls = [o for o in r.output if o.type == "function_call"]
        if not calls:
            break
        items += [o.model_dump(exclude_none=True) for o in r.output]
        for call in calls:
            try:
                args = json.loads(call.arguments or "{}")
            except ValueError:
                args = {}
            emit("status", tool_status(call.name, args))
            items.append({"type": "function_call_output", "call_id": call.call_id,
                          "output": run_tool(doc, call.name, args)})
    return "".join(text)


# ---------------------------------------------------------------- API keys at rest

class Keys:
    def __init__(self):
        from cryptography.fernet import Fernet
        path = os.path.join(STATE_DIR, "keys.secret")
        try:
            with open(path, "rb") as f:
                secret = f.read()
        except FileNotFoundError:
            secret = Fernet.generate_key()
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "wb") as f:
                f.write(secret)
        self.f = Fernet(secret)

    def seal(self, key):
        return self.f.encrypt(key.encode()).decode()

    def unseal(self, token):
        return self.f.decrypt(token.encode()).decode()


# ---------------------------------------------------------------- HTTP

CITE_RE = re.compile(r"\[p:(\d+)\]")


def clean_history(raw):
    """Earlier turns of the conversation, sent by the browser (which is where
    conversations are kept). Alternating user/assistant, starting with the user
    and ending with an answer, at most HISTORY_TURNS pairs."""
    out = []
    for m in raw if isinstance(raw, list) else []:
        if not (isinstance(m, dict) and m.get("role") in ("user", "assistant")
                and isinstance(m.get("content"), str) and m["content"].strip()):
            continue
        if (out[-1]["role"] if out else "assistant") == m["role"]:
            continue          # keep turns alternating
        out.append({"role": m["role"], "content": m["content"][:HISTORY_CHARS]})
    if out and out[-1]["role"] == "user":
        out.pop()             # a question that never got an answer
    return out[-HISTORY_TURNS * 2:]


class App:
    def __init__(self):
        self.catalog = Catalog(S["indexes"])
        self.keys = Keys()
        self.indexer = Indexer()

    def doc(self, dpath):
        r = idx().execute("SELECT * FROM docs WHERE path = ?", (dpath,)).fetchone()
        d = dict(r) if r else {"path": dpath, "name": doc_name(dpath), "status": "new"}
        p = self.indexer.progress.get(d.get("id"))
        if p:
            d["progress"] = {"fetched": p[0], "discovered": p[1], "indexed": p[2]}
        return d

    def settings(self, user):
        r = adb().execute("SELECT * FROM users WHERE name = ?", (user,)).fetchone()
        return dict(r) if r else {"name": user, "provider": None, "model": None, "key_enc": None,
                                  "key_hint": None, "privacy_ack": None}


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "tangerine-ask"
    sys_version = ""
    app: App = None

    def log_message(self, *args):
        pass

    @property
    def user(self):
        if self.client_address[0] not in ("127.0.0.1", "::1"):
            return None
        return (self.headers.get("X-Tangerine-User") or "").strip() or None

    def send(self, status, body=b"", ctype="application/json", cache="no-store"):
        if not isinstance(body, bytes):
            body = (json.dumps(body) if ctype == "application/json" else body).encode()
        self.send_response(status)
        self.send_header("Content-Type", ctype + ("; charset=utf-8" if ctype.startswith(("text/", "application/j")) else ""))
        self.send_header("Cache-Control", cache)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def json_body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 262144:
            return None
        try:
            return json.loads(self.rfile.read(n) or b"{}")
        except ValueError:
            return None

    def same_origin(self):
        origin = urllib.parse.urlparse(self.headers.get("Origin", "")).netloc
        return origin and origin == self.headers.get("Host")

    def doc_path_or_404(self, raw):
        d = canonical_doc_path(raw)
        return d if d and d in self.app.catalog else None

    def do_GET(self):
        path, _, query = self.path.partition("?")
        if path in ("/_ask/overlay.js", "/_ask/overlay.css"):
            return self.static(path.rsplit("/", 1)[1])
        user = self.user
        if not user:
            return self.send(401, {"error": "signed_out"})
        qs = {k: v[0] for k, v in urllib.parse.parse_qs(query).items()}
        if path == "/_ask/api/state":
            return self.state(user, qs)
        if path == "/_ask/api/models":
            return self.models(user)
        self.send(404, {"error": "not here"})

    def do_POST(self):
        path = self.path.partition("?")[0]
        user = self.user
        if not user:
            return self.send(401, {"error": "signed_out"})
        if not self.same_origin():
            return self.send(403, {"error": "bad origin"})
        body = self.json_body()
        if body is None:
            return self.send(400, {"error": "bad request"})
        if path == "/_ask/api/settings":
            return self.save_settings(user, body)
        if path == "/_ask/api/privacy":
            adb().execute("INSERT INTO users (name, privacy_ack) VALUES (?, ?) "
                          "ON CONFLICT(name) DO UPDATE SET privacy_ack = excluded.privacy_ack", (user, time.time()))
            return self.send(200, {"ok": True})
        if path == "/_ask/api/index":
            dpath = self.doc_path_or_404(body.get("path"))
            if not dpath:
                return self.send(404, {"error": "not a document this service can read"})
            self.app.indexer.request(dpath)
            return self.send(200, {"doc": self.app.doc(dpath)})
        if path == "/_ask/api/ask":
            return self.ask(user, body)
        self.send(404, {"error": "not here"})

    def static(self, name):
        for d in (SHARE_DIR, os.path.dirname(os.path.abspath(__file__))):
            p = os.path.join(d, name)
            if os.path.isfile(p):
                with open(p, "rb") as f:
                    ctype = "text/css" if name.endswith(".css") else "text/javascript"
                    return self.send(200, f.read(), ctype, cache="private, max-age=300")
        self.send(404, {"error": "not here"})

    def state(self, user, qs):
        dpath = self.doc_path_or_404(qs.get("path"))
        st = self.app.settings(user)
        out = {"user": user, "noun": S["noun"], "examples": S["examples"], "doc": None, "settings": {"provider": st["provider"], "model": st["model"],
                                                           "price": price(st["model"]) if st["model"] else None,
                                             "key_hint": st["key_hint"], "privacy_ack": bool(st["privacy_ack"])}}
        if dpath:
            d = self.app.doc(dpath)
            out["doc"] = {k: d.get(k) for k in ("path", "name", "status", "error", "pages", "progress")}
        self.send(200, out)

    def models(self, user):
        st = self.app.settings(user)
        if not st["key_enc"]:
            return self.send(400, {"error": "Save an API key first."})
        try:
            return self.send(200, {"models": priced(list_models(st["provider"], self.app.keys.unseal(st["key_enc"])))})
        except Exception as e:
            return self.send(502, {"error": provider_error(e)})

    def save_settings(self, user, body):
        provider = body.get("provider")
        if provider not in PROVIDERS:
            return self.send(400, {"error": "Pick a provider."})
        st = self.app.settings(user)
        db = adb()
        db.execute("INSERT OR IGNORE INTO users (name) VALUES (?)", (user,))
        key = (body.get("key") or "").strip()
        models = None
        if key:
            if len(key) > 512 or not re.fullmatch(r"[\x21-\x7e]+", key):
                return self.send(400, {"error": "That doesn't look like an API key."})
            try:
                models = list_models(provider, key)
            except Exception as e:
                return self.send(400, {"error": provider_error(e)})
            db.execute("UPDATE users SET provider = ?, key_enc = ?, key_hint = ?, model = NULL WHERE name = ?",
                       (provider, self.app.keys.seal(key), key[-4:], user))
            log("settings: %s saved their %s key" % (user, provider))
        elif provider != st["provider"]:
            # Switching provider without a new key would pair the wrong key with it.
            db.execute("UPDATE users SET provider = ?, key_enc = NULL, key_hint = NULL, model = NULL WHERE name = ?",
                       (provider, user))
        if body.get("model"):
            db.execute("UPDATE users SET model = ? WHERE name = ?", (str(body["model"])[:100], user))
        st = self.app.settings(user)
        out = {"ok": True, "settings": {"provider": st["provider"], "model": st["model"], "key_hint": st["key_hint"],
                                        "price": price(st["model"]) if st["model"] else None}}
        if models is not None:
            out["models"] = priced(models)
        self.send(200, out)

    def ask(self, user, body):
        dpath = self.doc_path_or_404(body.get("path"))
        question = (body.get("question") or "").strip()[:4000]
        if not dpath or not question:
            return self.send(400, {"error": "Need a document and a question."})
        st = self.app.settings(user)
        if not st["privacy_ack"]:
            return self.send(400, {"error": "privacy"})
        if not (st["key_enc"] and st["model"]):
            return self.send(400, {"error": "Set your provider, API key and model in settings first."})
        d = self.app.doc(dpath)
        if d["status"] != "ready":
            return self.send(409, {"error": "not_ready"})

        history = clean_history(body.get("history")) + [{"role": "user", "content": question}]
        idx().execute("UPDATE docs SET questions = questions + 1, last_asked = ? WHERE id = ?",
                      (time.time(), d["id"]))

        self.send_response(200)
        self.send_header("Content-Type", "text/event-stream; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Accel-Buffering", "no")
        self.end_headers()
        self.close_connection = True
        alive = [True]

        def emit(kind, data):
            if not alive[0]:
                raise ConnectionError("client went away")
            try:
                self.wfile.write(("data: %s\n\n" % json.dumps({"type": kind, "data": data})).encode())
                self.wfile.flush()
            except OSError:
                alive[0] = False
                raise ConnectionError("client went away")

        doc = Doc(d)
        system = system_prompt(d)
        key = self.app.keys.unseal(st["key_enc"])
        run = chat_anthropic if st["provider"] == "anthropic" else chat_openai
        answer, err = "", None
        try:
            answer = run(key, st["model"], system, history, doc, emit)
        except ConnectionError:
            err = "disconnected"
        except Exception as e:
            err = provider_error(e)
            log("ask: %s on %s failed: %r" % (user, dpath, e))
        cited = []
        for pid in dict.fromkeys(int(x) for x in CITE_RE.findall(answer)):
            meta = doc.seen.get(pid) or doc._remember(pid)
            if meta:
                cited.append(meta)
        try:
            if err and err != "disconnected":
                emit("error", err)
            emit("sources", cited)
            emit("done", None)
        except ConnectionError:
            pass


def serve():
    os.makedirs(STATE_DIR, exist_ok=True)
    upgrade_index_layout()
    Handler.app = App()
    host, _, port = S["listen"].rpartition(":")
    srv = http.server.ThreadingHTTPServer((host.strip("[]"), int(port)), Handler)
    srv.daemon_threads = True
    log("tangerine-ask listening on %s; index %.2f GB of %s GB (evicting at %d%%)"
        % (S["listen"], index_used_bytes(idx()) / 1e9, S["index_max_gb"], S["evict_at"] * 100))
    srv.serve_forever()


def main():
    import argparse
    global S
    ap = argparse.ArgumentParser(prog="tangerine-ask")
    ap.add_subparsers(dest="cmd", required=True).add_parser("serve")
    ap.parse_args()
    with open(CONFIG_FILE) as f:
        S = {**DEFAULTS, **(yaml.safe_load(f) or {})}
    serve()


if __name__ == "__main__":
    main()
