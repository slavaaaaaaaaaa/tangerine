def run_tool(doc, name, args):
    try:
        if name == "search":
            return doc.search(args.get("query", ""), bool(args.get("include_other_variants")))
        if name == "read_page":
            return doc.read_page(args.get("page_id"))
        if name == "list_sections":
            return doc.list_sections(args.get("path"))
        return "Unknown tool %s." % name
    except Exception as e:
        log("tool %s failed: %r" % (name, e))
        return "Tool error: %s" % e


def tool_status(name, args):
    if name == "search":
        return "Searching: %s" % args.get("query", "")
    if name == "read_page":
        return "Reading page %s" % args.get("page_id")
    return "Browsing: %s" % (" > ".join(args.get("path") or []) or "contents")


# Default instructions for the model. `system_prompt:` in the config replaces them;
# {name} and {sections} are filled in either way.
SYSTEM = """You answer questions using one document from a private archive: {name}.
Reach the document only through the tools.

How to work:
- Search before answering. Try a few phrasings, codes or names if the first search misses.
- Read a page before relying on it; search snippets are partial.
- Pages marked OTHER VARIANT were written for a different variant. Use them only when no page covers this one, and say so.

How to answer:
- Cite each fact from the document with its page id in square brackets right after it, like [p:123].
- Copy figures, specifications and identifiers exactly, with units.
- Keep the document's warnings and cautions.
- If the document doesn't cover it, say so plainly. You may add general knowledge, clearly labelled, without citations.
- Use Markdown. Steps as numbered lists. Be concise.
- Figures appear in page text as [figure N]; the user sees the figures of cited pages, so point to them by page.

Top-level sections of this document: {sections}"""


def system_prompt(d):
    sections = ", ".join(json.loads(d["sections"] or "[]")) or "(see list_sections)"
    return (S["system_prompt"] or SYSTEM).replace("{name}", d["name"]).replace("{sections}", sections)


