def merged(defaults, override):
    out = dict(defaults)
    for k, v in (override or {}).items():
        out[k] = merged(defaults[k], v) if isinstance(defaults.get(k), dict) and isinstance(v, dict) else v
    return out


def load_config(path=CONFIG_FILE):
    with open(path) as f:
        return yaml.safe_load(f) or {}


def gate_settings(config):
    return merged(GATE_DEFAULTS, config.get("gate"))


def config_users(config):
    """users: {name: {admin: bool}} -> {name: set(flags)}"""
    out = {}
    for name, opts in (config.get("users") or {}).items():
        name = str(name).lower()
        if USERNAME_RE.match(name):
            out[name] = {"admin"} if (opts or {}).get("admin") else set()
    return out


