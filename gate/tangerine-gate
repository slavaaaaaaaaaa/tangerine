def log(msg):
    print(msg, flush=True)


def b64e(b):
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def b64d(s):
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


# ---------------------------------------------------------------- passwords

def hash_password(pw):
    salt = secrets.token_bytes(16)
    dk = hashlib.scrypt(pw.encode(), salt=salt, maxmem=SCRYPT_MAXMEM, dklen=32, **SCRYPT)
    return "scrypt$%d$%d$%d$%s$%s" % (SCRYPT["n"], SCRYPT["r"], SCRYPT["p"], b64e(salt), b64e(dk))


def verify_password(pw, stored):
    try:
        kind, n, r, p, salt, dk = stored.split("$")
        if kind != "scrypt":
            return False
        want = b64d(dk)
        got = hashlib.scrypt(pw.encode(), salt=b64d(salt), n=int(n), r=int(r), p=int(p),
                             maxmem=SCRYPT_MAXMEM, dklen=len(want))
        return hmac.compare_digest(got, want)
    except Exception:
        return False


# Verified against when the username doesn't exist, so timing doesn't reveal it.
DUMMY_HASH = hash_password(secrets.token_hex(8))


def password_gen(stored):
    """Changes whenever the password does; baked into cookies so passwd/userdel log people out."""
    return hashlib.sha256(stored.encode()).hexdigest()[:16]


# ---------------------------------------------------------------- passwords file
# One line per user:  name:scrypt$...   (written only by `tangerine-gate passwd`)

def read_passwords(path):
    out = {}
    try:
        f = open(path)
    except FileNotFoundError:
        return out
    with f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#") and ":" in line:
                name, _, h = line.partition(":")
                out[name] = h
    return out


def write_passwords(passwords, path):
    lines = ["# tangerine password hashes -- manage with: tangerine-gate passwd NAME"]
    lines += ["%s:%s" % (n, passwords[n]) for n in sorted(passwords)]
    tmp = path + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    try:
        st = os.stat(path)
        os.chown(tmp, st.st_uid, st.st_gid)
        os.chmod(tmp, st.st_mode & 0o777)
    except FileNotFoundError:
        pass
    os.replace(tmp, path)


class Users:
    """Users allowed by config.yaml that have a password set. Both files are
    re-read (checked at most every 2s) when their mtime changes."""

    def __init__(self, config_path, passwords_path):
        self.paths = (config_path, passwords_path)
        self.mtimes = None
        self.checked = 0.0
        self.users = {}
        self.lock = threading.Lock()

    def get(self):
        with self.lock:
            now = time.monotonic()
            if now - self.checked > 2:
                self.checked = now
                mtimes = []
                for p in self.paths:
                    try:
                        mtimes.append(os.stat(p).st_mtime_ns)
                    except FileNotFoundError:
                        mtimes.append(None)
                if mtimes != self.mtimes:
                    try:
                        allowed = config_users(load_config(self.paths[0]))
                    except Exception as e:
                        log("config reload failed, keeping previous users: %s" % e)
                        return self.users
                    hashes = read_passwords(self.paths[1])
                    self.users = {n: {"hash": hashes[n], "flags": flags}
                                  for n, flags in allowed.items() if n in hashes}
                    self.mtimes = mtimes
            return self.users


# ---------------------------------------------------------------- where is this IP

class Geo:
    def __init__(self, path):
        self.reader = None
        self.cache = {}
        self.lock = threading.Lock()
        if not path:
            log("geoip: disabled in config")
            return
        try:
            import maxminddb
            self.reader = maxminddb.open_database(path)
            log("geoip: using %s" % path)
        except Exception as e:
            log("geoip: disabled (%s)" % e)

    def lookup(self, ip):
        with self.lock:
            if ip in self.cache:
                return self.cache[ip]
        try:
            addr = ipaddress.ip_address(ip)
        except ValueError:
            return ""
        if addr.is_private or addr.is_loopback:
            where = "local network"
        elif not self.reader:
            where = ""
        else:
            try:
                r = self.reader.get(ip) or {}
            except Exception:
                r = {}
            city = r.get("city", {}).get("names", {}).get("en")
            region = (r.get("subdivisions") or [{}])[0].get("names", {}).get("en")
            country = r.get("country", {}).get("names", {}).get("en") or r.get("country", {}).get("iso_code")
            where = ", ".join(x for x in (city, region, country) if x)
        with self.lock:
            if len(self.cache) > 10000:
                self.cache.clear()
            self.cache[ip] = where
        return where


def notify(title, message):
    """POST to gate.notify_url (ntfy-style: body is the message, Title header)."""
    if not S["notify_url"]:
        return

    def send():
        try:
            req = urllib.request.Request(S["notify_url"], data=message.encode(),
                                         headers={"Title": title, "Tags": "tangerine"})
            urllib.request.urlopen(req, timeout=10).close()
        except Exception as e:
            log("notify failed: %s" % e)

    threading.Thread(target=send, daemon=True).start()


# ---------------------------------------------------------------- audit log + sessions

SCHEMA = """
CREATE TABLE IF NOT EXISTS events (
    id INTEGER PRIMARY KEY, ts REAL NOT NULL, event TEXT NOT NULL, user TEXT,
    ip TEXT, rdns TEXT, geo TEXT, ua TEXT, detail TEXT);
CREATE INDEX IF NOT EXISTS events_ts ON events(ts);
CREATE INDEX IF NOT EXISTS events_user ON events(user, ts);
CREATE TABLE IF NOT EXISTS sessions (
    sid TEXT PRIMARY KEY, user TEXT NOT NULL, created REAL NOT NULL, expires REAL NOT NULL,
    last_seen REAL, ip TEXT, geo TEXT, ua TEXT, requests INTEGER NOT NULL DEFAULT 0,
    revoked INTEGER NOT NULL DEFAULT 0);
"""


def session_seconds(remember):
    return S["remember_days"] * 86400 if remember else S["session_hours"] * 3600


def open_db():
    db = sqlite3.connect(os.path.join(STATE_DIR, "audit.db"), check_same_thread=False,
                         isolation_level=None, timeout=10)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA journal_mode=WAL")
    db.executescript(SCHEMA)
    if "remember" not in [r["name"] for r in db.execute("PRAGMA table_info(sessions)")]:
        db.execute("ALTER TABLE sessions ADD COLUMN remember INTEGER NOT NULL DEFAULT 0")
    if db.execute("PRAGMA user_version").fetchone()[0] < 1:
        # Sessions from before "remember me" could last 30 days; cut them to a normal sign-in.
        db.execute("UPDATE sessions SET expires = MIN(expires, created + ?) WHERE revoked = 0",
                   (session_seconds(False),))
        db.execute("PRAGMA user_version = 1")
    return db


class Audit:
    def __init__(self, geo):
        self.geo = geo
        self.db = open_db()
        self.lock = threading.Lock()
        self.rdns_cache = {}
        self.dirty = set()
        now = time.time()
        rows = self.db.execute("SELECT * FROM sessions WHERE revoked = 0 AND expires > ?", (now,))
        self.sessions = {r["sid"]: dict(r) for r in rows}
        threading.Thread(target=self._flush_loop, daemon=True).start()

    def event(self, event, user, ip, ua, detail=""):
        user = (user or "")[:64]
        ua = (ua or "")[:300]
        where = self.geo.lookup(ip)
        with self.lock:
            eid = self.db.execute(
                "INSERT INTO events (ts, event, user, ip, geo, ua, detail) VALUES (?,?,?,?,?,?,?)",
                (time.time(), event, user, ip, where, ua, detail)).lastrowid
        # ip= must stay last: fail2ban anchors on it, and every other field is attacker-controlled.
        log("%s user=%r geo=%r ua=%r %sip=%s" % (event, user, where, ua,
                                                  (detail + " ") if detail else "", ip))
        threading.Thread(target=self._rdns, args=(eid, ip), daemon=True).start()
        return where

    def _rdns(self, eid, ip):
        name = self.rdns_cache.get(ip)
        if name is None:
            try:
                name = socket.gethostbyaddr(ip)[0]
            except Exception:
                name = ""
            self.rdns_cache[ip] = name
        if name:
            with self.lock:
                self.db.execute("UPDATE events SET rdns = ? WHERE id = ?", (name, eid))

    def seen_before(self, user, ip):
        with self.lock:
            return self.db.execute("SELECT 1 FROM events WHERE event = 'login' AND user = ? AND ip = ? LIMIT 1",
                                   (user, ip)).fetchone() is not None

    def new_session(self, user, ip, ua, remember):
        now = time.time()
        s = {"sid": secrets.token_urlsafe(16), "user": user, "created": now,
             "expires": now + session_seconds(remember), "last_seen": now, "ip": ip,
             "geo": self.geo.lookup(ip), "ua": (ua or "")[:300], "requests": 0, "revoked": 0,
             "remember": int(remember)}
        with self.lock:
            self.db.execute("INSERT INTO sessions VALUES (:sid,:user,:created,:expires,:last_seen,"
                            ":ip,:geo,:ua,:requests,:revoked,:remember)", s)
            self.sessions[s["sid"]] = s
        return s

    def touch(self, sid, ip, ua):
        """Called on every proxied request. Returns the live session or None."""
        with self.lock:
            s = self.sessions.get(sid)
            if not s or s["revoked"] or s["expires"] < time.time():
                return None
            s["last_seen"] = time.time()
            s["requests"] += 1
            moved = s["ip"] != ip
            if moved:
                old, s["ip"], s["ua"] = s["ip"], ip, (ua or "")[:300]
            self.dirty.add(sid)
        if moved:
            s["geo"] = self.event("session_ip_change", s["user"], ip, ua, "from=%s" % old)
        return s

    def revoke(self, sid):
        with self.lock:
            self.db.execute("UPDATE sessions SET revoked = 1 WHERE sid = ?", (sid,))
            s = self.sessions.pop(sid, None)
        return s

    def _flush_loop(self):
        while True:
            time.sleep(30)
            try:
                self.flush()
            except Exception as e:
                log("flush failed: %s" % e)

    def flush(self):
        now = time.time()
        with self.lock:
            for sid in self.dirty:
                s = self.sessions.get(sid)
                if s:
                    self.db.execute("UPDATE sessions SET last_seen=?, ip=?, geo=?, ua=?, requests=? "
                                    "WHERE sid=?", (s["last_seen"], s["ip"], s["geo"], s["ua"],
                                                    s["requests"], sid))
            self.dirty.clear()
            # Pick up revocations made from the CLI.
            for r in self.db.execute("SELECT sid FROM sessions WHERE revoked = 1 AND last_seen > ?",
                                     (now - session_seconds(True),)):
                self.sessions.pop(r["sid"], None)
            for sid in [k for k, s in self.sessions.items() if s["expires"] < now]:
                del self.sessions[sid]

    def recent_events(self, limit=200, user=None):
        q, args = "SELECT * FROM events", []
        if user:
            q, args = q + " WHERE user = ?", [user]
        with self.lock:
            return self.db.execute(q + " ORDER BY ts DESC LIMIT ?", args + [limit]).fetchall()


class Throttle:
    """Sliding window failure counter."""

    def __init__(self, limit, window):
        self.limit, self.window = limit, window
        self.hits = {}
        self.lock = threading.Lock()

    def _prune(self, key):
        cutoff = time.time() - self.window
        hits = [t for t in self.hits.get(key, []) if t > cutoff]
        if hits:
            self.hits[key] = hits
        else:
            self.hits.pop(key, None)
        return hits

    def blocked(self, key):
        with self.lock:
            return len(self._prune(key)) >= self.limit

    def hit(self, key):
        """Record a failure; True when this one tripped the limit."""
        with self.lock:
            hits = self._prune(key)
            hits.append(time.time())
            self.hits[key] = hits
            return len(hits) == self.limit


