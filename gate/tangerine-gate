def fmt_ts(ts):
    return time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(ts)) if ts else ""


def ago(ts):
    if not ts:
        return ""
    d = int(time.time() - ts)
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= n:
            return "%d%s ago" % (d // n, unit)
    return "just now"


def until(ts):
    d = int(ts - time.time())
    if d <= 0:
        return "expired"
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if d >= n:
            return "in %d%s" % (d // n, unit)
    return "in <1m"


def short_ua(ua):
    ua = ua or ""
    os_name = next((n for k, n in (("iPhone", "iPhone"), ("iPad", "iPad"), ("Android", "Android"),
                                   ("CrOS", "ChromeOS"), ("Mac OS X", "macOS"), ("Windows", "Windows"),
                                   ("Linux", "Linux")) if k in ua), "")
    browser = next((n for k, n in (("Edg/", "Edge"), ("OPR/", "Opera"), ("FxiOS", "Firefox"),
                                   ("Firefox/", "Firefox"), ("CriOS", "Chrome"), ("Chrome/", "Chrome"),
                                   ("Safari/", "Safari"), ("curl/", "curl")) if k in ua), "")
    if not browser:
        return ua[:40] or "?"
    return browser + (" on " + os_name if os_name else "")


# ---------------------------------------------------------------- HTTP

def safe_next(url):
    if (not url or not url.startswith("/") or url.startswith("//") or "\\" in url
            or url.startswith("/_gate/") or any(ord(c) < 0x21 or ord(c) == 0x7f for c in url)):
        return "/"
    return url


class Gate:
    def __init__(self):
        self.secret = load_secret()
        self.users = Users(CONFIG_FILE, S["passwords_file"])
        self.audit = Audit(Geo(os.path.join(STATE_DIR, "dbip-city-lite.mmdb") if S["geoip"] else None))
        t = S["throttle"]
        self.fail_ip = Throttle(t["per_ip"], t["window_minutes"] * 60)
        self.fail_user = Throttle(t["per_user"], t["window_minutes"] * 60)

    def authenticate(self, name, password):
        u = self.users.get().get(name)
        ok = verify_password(password, u["hash"] if u else DUMMY_HASH)
        return u if (ok and u) else None

    def session_from(self, cookie_header, ip, ua):
        token = None
        for part in (cookie_header or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == COOKIE:
                token = v
        p = unsign(self.secret, token) if token else None
        if not p or p.get("exp", 0) < time.time():
            return None, None
        u = self.users.get().get(p.get("u"))
        if not u or password_gen(u["hash"]) != p.get("g"):
            return None, None
        s = self.audit.touch(p.get("sid"), ip, ua)
        return (s, u) if s else (None, None)


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "tangerine"
    sys_version = ""
    gate: Gate = None

    def log_message(self, *args):
        pass

    @property
    def ip(self):
        if self.client_address[0] in ("127.0.0.1", "::1"):
            real = (self.headers.get("X-Real-IP") or "").strip()
            if real:
                return real
        return self.client_address[0]

    @property
    def ua(self):
        return self.headers.get("User-Agent", "")

    def session(self):
        return self.gate.session_from(self.headers.get("Cookie"), self.ip, self.ua)

    def send(self, status, body=b"", headers=()):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(status)
        self.send_header("Cache-Control", "no-store")
        for k, v in headers:
            self.send_header(k, v)
        if body:
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; "
                             "img-src data:; form-action 'self'; frame-ancestors 'none'; base-uri 'none'")
            self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def redirect(self, location, cookie=None):
        headers = [("Location", location)]
        if cookie is not None:
            headers.append(("Set-Cookie", cookie))
        self.send(303, headers=headers)

    def cookie(self, value, max_age):
        return "%s=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Lax%s" % (
            COOKIE, value, max_age, "; Secure" if COOKIE_SECURE else "")

    def form(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n > 8192:
            return {}
        data = self.rfile.read(n).decode("utf-8", "replace")
        return {k: v[0] for k, v in urllib.parse.parse_qs(data, keep_blank_values=True).items()}

    # -- routing

    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        path, _, query = self.path.partition("?")
        if path == "/_gate/check":
            return self.check()
        if path == "/_gate/login":
            return self.login_get(query)
        if path == "/_gate/logout":
            return self.logout()
        if path == "/_gate/admin":
            return self.admin(query)
        self.send(404, "not here")

    def do_POST(self):
        path = self.path.partition("?")[0]
        if path == "/_gate/login":
            return self.login_post()
        if path == "/_gate/admin/revoke":
            return self.admin_revoke()
        self.send(404, "not here")

    # -- endpoints

    def check(self):
        s, _ = self.session()
        if s:
            self.send(204, headers=[("X-Tangerine-User", s["user"])])
        else:
            self.send(401)

    def login_get(self, query):
        if query == "bye":
            return self.send(200, login_page("/", S["login_page"]["goodbye"], "ok"))
        # nginx passes $request_uri through unescaped, so take everything after next=.
        nxt = query[5:] if query.startswith("next=") else "/"
        s, _ = self.session()
        if s:
            return self.redirect(safe_next(nxt))
        self.send(200, login_page(safe_next(nxt)))

    def login_post(self):
        f = self.form()
        name = f.get("user", "").strip().lower()
        nxt = safe_next(f.get("next", "/"))
        ip, ua, audit = self.ip, self.ua, self.gate.audit
        if self.gate.fail_ip.blocked(ip) or self.gate.fail_user.blocked(name):
            audit.event("login_throttled", name, ip, ua)
            return self.send(429, login_page(nxt, S["login_page"]["throttled"]))
        u = self.gate.authenticate(name, f.get("password", ""))
        if not u:
            where = audit.event("login_failed", name, ip, ua)
            tripped_ip = self.gate.fail_ip.hit(ip)
            tripped_user = self.gate.fail_user.hit(name)
            if tripped_ip or tripped_user:
                notify("tangerine: someone is guessing passwords",
                       "%d+ failed logins, last as %r from %s (%s)" % (
                           self.gate.fail_ip.limit, name, ip, where or "unknown location"))
            return self.send(401, login_page(nxt, random.choice(S["login_page"]["wrong_password"] or ["Nope."])))
        new_ip = not audit.seen_before(name, ip)
        remember = f.get("remember") == "1"
        s = audit.new_session(name, ip, ua, remember)
        where = audit.event("login", name, ip, ua, " ".join(
            x for x in ("new_ip" if new_ip else "", "remember" if remember else "") if x))
        notify("tangerine: %s signed in%s" % (name, " from a new IP" if new_ip else ""),
               "%s from %s (%s)\n%s" % (name, ip, where or "unknown location", short_ua(ua)))
        token = sign(self.gate.secret, {"u": name, "sid": s["sid"], "g": password_gen(u["hash"]),
                                        "exp": int(s["expires"])})
        self.redirect(nxt, self.cookie(token, session_seconds(remember)))

    def logout(self):
        s, _ = self.session()
        if s:
            self.gate.audit.revoke(s["sid"])
            self.gate.audit.event("logout", s["user"], self.ip, self.ua)
        self.redirect("/_gate/login?bye", self.cookie("", 0))

    def admin(self, query):
        s, u = self.session()
        if not s:
            return self.redirect("/_gate/login?next=/_gate/admin")
        if "admin" not in u["flags"]:
            return self.send(403, page(S["login_page"]["title"], '<main class="wrap"><div class="card">%s<h1>Not for you</h1>'
                                       '<p class="tag">This part of the tangerine is staff only.</p>'
                                       '<p><a href="/">Back</a></p></div></main>' % FRUIT))
        user = urllib.parse.parse_qs(query).get("user", [None])[0]
        self.send(200, admin_page(self.gate, user))

    def admin_revoke(self):
        s, u = self.session()
        if not s or "admin" not in u["flags"]:
            return self.send(403, "no")
        origin = urllib.parse.urlparse(self.headers.get("Origin", "")).netloc
        if not origin or origin != self.headers.get("Host"):
            return self.send(403, "bad origin")
        sid = self.form().get("sid", "")
        victim = self.gate.audit.revoke(sid)
        if victim:
            self.gate.audit.event("session_revoked", victim["user"], self.ip, self.ua, "by=%s" % s["user"])
        self.redirect("/_gate/admin")


def admin_page(gate, only_user=None):
    e = html.escape
    audit = gate.audit
    with audit.lock:
        live = sorted(audit.sessions.values(), key=lambda s: -(s["last_seen"] or 0))
    rows = []
    for s in live:
        rows.append("<tr><td><a href='?user=%s'>%s</a></td><td title='%s'>%s</td><td>%s</td><td>%s</td>"
                    "<td title='%s'>%s</td><td>%d</td><td>%s</td><td title='%s'>%s%s</td>"
                    "<td><form method=post action='/_gate/admin/revoke'>"
                    "<input type=hidden name=sid value='%s'><button class=mini>kick</button></form></td></tr>" % (
                        e(urllib.parse.quote(s["user"])), e(s["user"]), e(fmt_ts(s["last_seen"])),
                        e(ago(s["last_seen"])), e(s["ip"] or ""), e(s["geo"] or ""), e(s["ua"] or ""),
                        e(short_ua(s["ua"])), s["requests"], e(fmt_ts(s["created"])), e(fmt_ts(s["expires"])),
                        e(until(s["expires"])), " (remembered)" if s.get("remember") else "", e(s["sid"])))
    events = []
    for r in audit.recent_events(300, only_user):
        cls = "bad" if r["event"] in ("login_failed", "login_throttled") else ""
        events.append("<tr class='%s'><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td>"
                      "<td title='%s'>%s</td><td>%s</td></tr>" % (
                          cls, e(fmt_ts(r["ts"])), e(r["event"]), e(r["user"] or ""), e(r["ip"] or ""),
                          e(r["rdns"] or ""), e(r["geo"] or ""), e(r["ua"] or ""), e(short_ua(r["ua"])),
                          e(r["detail"] or "")))
    users = gate.users.get()
    filt = (" &middot; showing <b>%s</b> &middot; <a href='/_gate/admin'>everyone</a>" % e(only_user)) if only_user else ""
    body = """<main class="wrap" style="text-align:left"><h1>%s %s &middot; door log</h1>
<p class="tag">%d users &middot; %d live sessions &middot; times in %s%s &middot; <a href="/">back</a></p>
<h2>Who's here</h2><div class=scroll><table><tr><th>user</th><th>last seen</th><th>ip</th><th>where</th>
<th>browser</th><th>requests</th><th>signed in</th><th>signs out</th><th></th></tr>%s</table></div>
<h2>Door log</h2><div class=scroll><table><tr><th>time</th><th>event</th><th>user</th><th>ip</th><th>host</th>
<th>where</th><th>browser</th><th>detail</th></tr>%s</table></div>
<p class="foot"><a href="https://db-ip.com">IP Geolocation by DB-IP</a></p></main>
<style>h2{font-size:16px;margin:28px 0 8px}.scroll{overflow-x:auto;border:1px solid var(--line);border-radius:12px;background:var(--card)}
table{border-collapse:collapse;width:100%%;font-size:13px}th,td{padding:6px 10px;text-align:left;white-space:nowrap;border-bottom:1px solid var(--line)}
th{color:var(--muted);font-weight:500}tr.bad td{color:var(--bad)}.fruit{width:28px;height:28px;vertical-align:-6px}
a{color:var(--accent)}button.mini{margin:0;width:auto;padding:2px 10px;font-size:12px}</style>""" % (
        FRUIT, e(S["login_page"]["title"]), len(users), len(live), e(time.strftime("%Z")), filt,
        "".join(rows) or "<tr><td colspan=9>nobody</td></tr>",
        "".join(events) or "<tr><td colspan=8>nothing yet</td></tr>")
    return page(S["login_page"]["title"] + " door log", body, width=1200)


def serve():
    if "session_days" in (load_config().get("gate") or {}):
        log("gate.session_days is no longer used (sign-ins last session_hours, or remember_days "
            "with \"Remember me\"); remove it from config.yaml")
    Handler.gate = Gate()
    host, _, port = S["listen"].rpartition(":")
    srv = http.server.ThreadingHTTPServer((host.strip("[]"), int(port)), Handler)
    srv.daemon_threads = True
    log("tangerine-gate listening on %s (%d users)" % (S["listen"], len(Handler.gate.users.get())))
    srv.serve_forever()


# ---------------------------------------------------------------- CLI

def drop_to_service_user():
    """DB commands run as the service user so root never owns audit.db or its WAL files."""
    if os.geteuid() == 0:
        pw = pwd.getpwnam(SERVICE_USER)
        os.setgroups([])
        os.setgid(pw.pw_gid)
        os.setuid(pw.pw_uid)


def ask_password(random_pw):
    if random_pw:
        pw = secrets.token_urlsafe(12)
        print("password: %s" % pw)
        return pw
    pw = getpass.getpass("password: ")
    if len(pw) < 10:
        sys.exit("use at least 10 characters (or --random)")
    if getpass.getpass("again: ") != pw:
        sys.exit("passwords don't match")
    return pw


def main():
    global S
    ap = argparse.ArgumentParser(prog="tangerine-gate")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("serve")
    p = sub.add_parser("passwd", help="set (or --delete) a user's password")
    p.add_argument("name"); p.add_argument("--random", action="store_true"); p.add_argument("--delete", action="store_true")
    sub.add_parser("users", help="users from config.yaml, password status, last login")
    p = sub.add_parser("log", help="door log")
    p.add_argument("-n", type=int, default=50); p.add_argument("--user"); p.add_argument("--failed", action="store_true")
    sub.add_parser("sessions", help="live sessions")
    p = sub.add_parser("revoke", help="end a session, or all of a user's sessions")
    p.add_argument("sid", nargs="?"); p.add_argument("--user")
    a = ap.parse_args()

    config = load_config()
    S = gate_settings(config)
    allowed = config_users(config)

    if a.cmd == "serve":
        return serve()

    if a.cmd == "passwd":
        name = a.name.lower()
        passwords = read_passwords(S["passwords_file"])
        if a.delete:
            if passwords.pop(name, None) is None:
                sys.exit("%s has no password set" % name)
        else:
            if name not in allowed:
                sys.exit("%s is not listed under users: in %s -- add them there first" % (name, CONFIG_FILE))
            passwords[name] = hash_password(ask_password(a.random))
        write_passwords(passwords, S["passwords_file"])
        print("%s: password %s (their existing sessions end within a few seconds)"
              % (name, "deleted" if a.delete else "set"))
        return

    passwords = read_passwords(S["passwords_file"])
    drop_to_service_user()
    db = open_db()
    if a.cmd == "users":
        for name in sorted(set(allowed) | set(passwords)):
            r = db.execute("SELECT ts, ip, geo FROM events WHERE user = ? AND event = 'login' "
                           "ORDER BY ts DESC LIMIT 1", (name,)).fetchone()
            last = "%s from %s (%s)" % (fmt_ts(r["ts"]), r["ip"], r["geo"]) if r else "never"
            if name not in allowed:
                status = "not in config (password left over; passwd --delete)"
            elif name not in passwords:
                status = "no password yet"
            else:
                status = "ok"
            print("%-16s %-6s %-14s last login: %s" % (
                name, ",".join(sorted(allowed.get(name, ()))), status, last))
    elif a.cmd == "log":
        q, args = "SELECT * FROM events WHERE 1=1", []
        if a.user:
            q += " AND user = ?"; args.append(a.user)
        if a.failed:
            q += " AND event IN ('login_failed', 'login_throttled')"
        for r in reversed(db.execute(q + " ORDER BY ts DESC LIMIT ?", args + [a.n]).fetchall()):
            print("%s  %-18s %-12s %-39s %-30s %s  %s %s" % (
                fmt_ts(r["ts"]), r["event"], r["user"], r["ip"], r["geo"] or "", r["rdns"] or "",
                short_ua(r["ua"]), r["detail"] or ""))
    elif a.cmd == "sessions":
        for r in db.execute("SELECT * FROM sessions WHERE revoked = 0 AND expires > ? ORDER BY last_seen DESC",
                            (time.time(),)):
            print("%s  %-12s last seen %-10s signs out %-8s %-39s %-30s %6d reqs  %s" % (
                r["sid"], r["user"], ago(r["last_seen"]), until(r["expires"]), r["ip"], r["geo"] or "",
                r["requests"], short_ua(r["ua"])))
    elif a.cmd == "revoke":
        if a.user:
            n = db.execute("UPDATE sessions SET revoked = 1 WHERE user = ? AND revoked = 0", (a.user,)).rowcount
        elif a.sid:
            n = db.execute("UPDATE sessions SET revoked = 1 WHERE sid = ?", (a.sid,)).rowcount
        else:
            sys.exit("give a session id or --user")
        print("revoked %d session(s); takes effect within 30s" % n)


if __name__ == "__main__":
    main()
